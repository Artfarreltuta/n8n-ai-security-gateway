      "parameters": {
        "jsCode": "// Extract the callback string sent by the button (e.g., \"approve_34\")\nconst callbackData = $input.item.json.data || $input.item.json.callback_query?.data;\n\nif (!callbackData) {\n    throw new Error(\"No callback data found in the payload\");\n}\n\n// Split the string into the action (approve/block) and the Execution ID (34)\nconst [action, executionId] = callbackData.split('_');\n\n// Prepare the parsed data for the webhook call\nreturn {\n    json: {\n        action: action, // 'approve' or 'block'\n        executionId: executionId // e.g., '34'\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
