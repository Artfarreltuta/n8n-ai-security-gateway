      ],
      "id": "7738ca26-6e37-4119-aafb-a4d7024af408",
      "name": "Mock Local LLM"
    },
    {
      "parameters": {
        "jsCode": "// Retrieve the generated text from the LLM\nlet llmResponse = $input.item.json.choices[0].message.content;\nconst vault = $input.item.json.vault || {};\n\n// Iterate through the vault and replace placeholders with original secrets\nfor (const [placeholder, secret] of Object.entries(vault)) {\n    // Using split and join to replace ALL occurrences in case the LLM repeated the placeholder\n    llmResponse = llmResponse.split(placeholder).join(secret);\n}\n\n// Prepare the clean final output\nreturn {\n    json: {\n        status: \"success\",\n        final_response: llmResponse\n        // Notice: We intentionally drop the 'vault' here so secrets don't leak into logs\n    }\n};"
      },
