      "parameters": {
        "jsCode": "return {\n  json: {\n    // Mocking a standard LLM API response structure\n    choices: [{\n      message: {\n        content: \"This is a response from the secure local fallback. I have analyzed your prompt: \" + $input.item.json.prompt\n      }\n    }],\n    // Pass the vault forward to the unmasking step\n    vault: $input.item.json.vault\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
